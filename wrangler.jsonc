{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fanzzy-web",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "env": {
    "staging": {
      "name": "fanzzy-staging",
      "workers_dev": true,
      "images": {
        "binding": "IMAGES"
      }
    }
  }
}
